reloadable=true

[libraries]
linux.debug.x86_64="./bin/gdex_toml_2.linux.debug.so"
linux.release.x86_64="./bin/gdex_toml_2.linux.release.so"
windows.debug.x86_64="./bin/gdex_toml_2.windows.debug.dll"
windows.release.x86_64="./bin/gdex_toml_2.windows.release.dll"
